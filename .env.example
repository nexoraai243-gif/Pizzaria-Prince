# ==============================================================
# PIZZARIA PRINCE — VARIÁVEIS DE AMBIENTE (ENV VARS)
# ==============================================================

# Segredo para assinatura de tokens JWT de administrador
# IMPORTANTE: Configure um valor aleatório forte na Vercel (ex: openssl rand -base64 32)
JWT_SECRET="pizzaria-prince-secret-key-change-in-production"

# Credenciais do administrador principal
ADMIN_INITIAL_EMAIL="nexoraai243@gmail.com"
ADMIN_INITIAL_PASSWORD="kenyseixas243"

# Directório da base de dados SQLite (Opcional)
# Na Vercel, o sistema detecta automaticamente o ambiente serverless e utiliza /tmp
# Em servidor dedicado/VPS/Docker, utiliza ./data
DB_DIR=""

# Porta do servidor em desenvolvimento local / Docker (Opcional, predefinição: 3000)
PORT=3000

# URL pública da aplicação (Injetada automaticamente pela plataforma)
APP_URL="https://seu-projeto.vercel.app"
